@model PublicPage
@{
    var lang = Model.Lang;
    var section = Model.Section;
    var cards = section is "home" or "products" or "packages" or "gallery";
}
@if (section == "home")
{
    <section class="hero shell">
        <div class="hero-copy">
            <p class="overline"><span></span> @Model.T("Penyewaan audio · Jawa Timur", "Audio rental · East Java")</p>
            <h1>@(Model.Entry?.Title(lang) ?? Model.T("Suara untuk setiap acara.", "Sound for every event."))</h1>
            <p class="intro">@Model.Entry?.Body(lang)</p>
            <div class="actions">
                <a class="btn btn-primary" href="@Model.HomeTarget("primary-cta", "products")">@Model.HomeTitle("primary-cta", "Lihat Peralatan", "Browse Equipment") <span aria-hidden="true">↗</span></a>
                <a class="btn btn-outline" href="@Model.HomeTarget("secondary-cta", "contact")">@Model.HomeTitle("secondary-cta", "Hubungi Kami", "Contact Us")</a>
            </div>
        </div>
        @{
            var heroImage = Model.Entry?.Images.OrderBy(x => x.Sort).FirstOrDefault();
        }
        <div class="hero-visual">
            <img src="@(heroImage is null ? "/images/stage.webp" : $"/media/{heroImage.MediaId}")" alt="@(heroImage?.Media.Alt(lang) ?? Model.T("Speaker panggung dengan pencahayaan ungu", "Stage speakers under purple lighting"))" fetchpriority="high">
            <div class="photo-caption"><span></span> WANDI SOUND SYSTEM</div>
        </div>
    </section>
    <div class="feature-band">
        <div class="shell feature-inner">
            <span>@Model.T("Pernikahan", "Weddings")</span>
            <span>@Model.T("Acara Perusahaan", "Corporate Events")</span>
            <span>@Model.T("Acara Keluarga", "Family Events")</span>
        </div>
    </div>
    @if (Model.Introduction is not null)
    {
        <section class="shell section home-intro">
            <h2>@Model.Introduction.Title(lang)</h2>
            <p class="long-copy">@Model.Introduction.Body(lang)</p>
            <a class="text-link" href="@Model.Path("about")">@Model.Label("about") ↗</a>
        </section>
    }
}
<section class="shell section">
    @if (section != "home")
    {
        <nav class="crumb" aria-label="@Model.T("Jejak halaman", "Breadcrumb")"><a href="@Model.Path("home")">@Model.Label("home")</a> <span aria-hidden="true">/</span> @Model.Label(section)</nav>
        <h1>@(Model.Entry?.Title(lang) ?? Model.Label(section))</h1>
    }
    else
    {
        <div class="section-heading">
            <div><p class="overline"><span></span> @Model.T("Katalog sewa", "Rental catalog")</p><h2>@Model.HomeTitle("products", "Pilihan untuk acara Anda", "Equipment for your event")</h2></div>
            <a class="text-link" href="@Model.Path("packages")">@Model.T("Lihat paket", "View packages") ↗</a>
        </div>
    }
    @if (section == "about" && Model.Entry is not null)
    {
        <p class="long-copy">@Model.Entry.Body(lang)</p>
        <partial name="_Images" model="(Model.Entry, lang)" />
    }
    @if (section == "products" && Model.Categories.Count > 0)
    {
        <nav class="filters" aria-label="@Model.T("Filter kategori", "Category filter")">
            <a class="pill @(Model.Category is null ? "selected" : "")" href="@Model.Path(section)">@Model.T("Semua", "All")</a>
            @foreach (var category in Model.Categories)
            {
                <a class="pill @(Model.Category == category.Slug ? "selected" : "")" href="@Model.Path(section)?category=@category.Slug">@category.Title(lang)</a>
            }
        </nav>
    }
    @if (cards)
    {
        <div class="card-grid">
            @foreach (var item in Model.Entries)
            {
                <partial name="_EntryCard" model="(Model, item)" />
            }
        </div>
    }
    @if (section == "faq")
    {
        <div class="questions">
            @foreach (var item in Model.Entries)
            {
                <details><summary>@item.Title(lang)</summary><p class="long-copy">@item.Body(lang)</p></details>
            }
        </div>
    }
    @if (section == "home" && Model.Testimonials.Count > 0)
    {
        <h2 class="mt-5">@Model.HomeTitle("testimonials", "Testimoni", "Testimonials")</h2>
    }
    @if (section is "testimonials" or "home")
    {
        <div class="card-grid mt-3">
            @foreach (var item in section == "home" ? Model.Testimonials : Model.Entries)
            {
                <figure class="panel quote"><blockquote>@item.Body(lang)</blockquote><figcaption>@item.Title(lang)</figcaption></figure>
            }
        </div>
    }
    @if (section != "contact" && Model.Entry is null && Model.Entries.Count == 0)
    {
        <p class="empty-state">@Model.T("Belum ada konten yang tersedia.", "No content is available yet.")</p>
    }
    @if (section == "contact")
    {
        <div class="contact-grid">
            <section class="panel">
                <h2>@Model.T("Kirim pertanyaan", "Send an inquiry")</h2>
                <p>@Model.T("Nama dan pesan Anda akan tersimpan di dasbor WD Sound.", "Your name and message will be saved to the WD Sound dashboard.")</p>
                @if (TempData["ContactSaved"] is not null)
                {
                    <p role="status" class="notice">@Model.T("Pesan Anda sudah tersimpan.", "Your message has been saved.")</p>
                }
                <form method="post" action="@Model.Path(section)" class="form-stack">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation"></div>
                    <label for="Name">@Model.T("Nama", "Name")</label>
                    <input id="Name" name="Name" value="@Model.Contact.Name" required maxlength="100" autocomplete="name">
                    <label for="Message">@Model.T("Pesan", "Message")</label>
                    <textarea id="Message" name="Message" required maxlength="2000" rows="5">@Model.Contact.Message</textarea>
                    <div hidden><label for="Website">Website</label><input id="Website" name="Website" tabindex="-1" autocomplete="off"></div>
                    <button class="btn btn-primary" type="submit">@Model.T("Kirim Pesan", "Send Message")</button>
                </form>
            </section>
            <aside class="panel">
                <h2>@Model.T("Hubungi langsung", "Contact directly")</h2>
                <p>@Model.Settings.Address</p><p>@Model.Settings.Hours</p>
                <partial name="_Channels" model="Model" />
            </aside>
        </div>
    }
</section>

@if (section == "home")
{
    @foreach (var (sectionKey, items) in new[] { ("packages", Model.Packages), ("gallery", Model.Gallery) })
    {
        @if (items.Count > 0)
        {
            <section class="shell section home-extra">
                <div class="section-heading">
                    <h2>@Model.HomeTitle(sectionKey, Model.Label(sectionKey), Model.Label(sectionKey))</h2>
                    <a class="text-link" href="@Model.Path(sectionKey)">@Model.T("Lihat semua", "View all") ↗</a>
                </div>
                <div class="card-grid">
                    @foreach (var item in items)
                    {
                        <partial name="_EntryCard" model="(Model, item)" />
                    }
                </div>
            </section>
        }
    }
    @if (Model.Questions.Count > 0)
    {
        <section class="shell section home-extra">
            <h2>@Model.HomeTitle("faq", "FAQ", "FAQ")</h2>
            <div class="questions">
                @foreach (var item in Model.Questions)
                {
                    <details><summary>@item.Title(lang)</summary><p class="long-copy">@item.Body(lang)</p></details>
                }
            </div>
        </section>
    }
    <section class="shell section home-extra">
        <div class="panel">
            <h2>@Model.HomeTitle("contact", "Kontak", "Contact")</h2>
            <a class="btn btn-primary" href="@Model.Path("contact")">@Model.T("Tanya kebutuhan acara", "Ask about your event") ↗</a>
        </div>
    </section>
}
